# ShopLedger Backend Environment Variables

# Application Configuration
PORT=5000
NODE_ENV=production

# Database Configuration (MongoDB Atlas connection string with replica set for ACID transactions)
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/shopledger?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://username:password@cluster0.mongodb.net/shopledger?retryWrites=true&w=majority

# Security Configuration
JWT_SECRET=replace_with_a_secure_random_string_in_production_min_32_chars
JWT_EXPIRE=30d

# CORS Configuration (comma-separated origins allowed to access the API)
# In production, set to your Vercel deployment URL (e.g., https://shopledger.vercel.app)
CLIENT_URL=http://localhost:5173,https://shopledger.vercel.app

