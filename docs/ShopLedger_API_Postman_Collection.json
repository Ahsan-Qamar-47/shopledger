    {
      "name": "Transactions",
      "item": [
        {
          "name": "Create Inventory Sale",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": \"<CUSTOMER_ID>\",\n  \"isInventorySale\": true,\n  \"items\": [\n    {\n      \"productId\": \"<PRODUCT_ID>\",\n      \"quantity\": 2\n    }\n  ],\n  \"notes\": \"Inventory sale\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/transactions/sale",
              "host": ["{{baseUrl}}"],
              "path": ["transactions", "sale"]
            }
          }
        },
        {
          "name": "Create Service Sale",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": \"<CUSTOMER_ID>\",\n  \"isInventorySale\": false,\n  \"amount\": 1200,\n  \"notes\": \"Maintenance & labor service charge\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/transactions/sale",
              "host": ["{{baseUrl}}"],
              "path": ["transactions", "sale"]
